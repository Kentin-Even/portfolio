# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)

# Clé API Anthropic (optionnelle)
ANTHROPIC_API_KEY=

# URL PostgreSQL (en local hors Docker ; docker-compose la reconstruit lui-même)
DATABASE_URL=postgres://user:password@localhost:5432/portfolio

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Docker Compose (service Postgres)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio
