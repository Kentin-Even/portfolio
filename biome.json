{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.output",
			"!**/.nitro",
			"!**/.tanstack",
			"!**/drizzle",
			"!**/src/routeTree.gen.ts",
			"!**/components.json",
			"!**/.claude",
			"!**/.cta.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"useImportType": "error",
				"noNonNullAssertion": "warn"
			},
			"suspicious": {
				"noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } }
			}
		},
		"domains": { "react": "recommended", "test": "recommended" }
	},
	"overrides": [
		{
			"includes": ["e2e/**", "**/*.test.ts", "**/*.test.tsx", "vitest.setup.ts"],
			"linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
		}
	],
	"css": { "parser": { "tailwindDirectives": true } }
}
